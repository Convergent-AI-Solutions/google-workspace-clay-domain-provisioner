# Copy to .env and fill in. Every value can also be passed as a CLI flag or
# entered at the interactive prompt — nothing here is required to be a file.
# .env is gitignored; this example file is the only one committed.

# ---------------------------------------------------------------------------
# Cloudflare
# ---------------------------------------------------------------------------
# API token needs: Registrar write (search/check/register) + Zone.DNS edit.
CEDP_CF_API_TOKEN=
CEDP_CF_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Google Workspace
# ---------------------------------------------------------------------------
# Path to EITHER a service-account JSON with domain-wide delegation, OR an
# OAuth client-secrets JSON. The tool detects which by the file's "type" field.
CEDP_GOOGLE_CREDENTIALS=
# Super-admin address. Required for a service account (it is impersonated);
# ignored for the OAuth flow, where you sign in as the admin instead.
CEDP_GOOGLE_ADMIN_EMAIL=
# Leave as my_customer unless you administer several Workspace accounts.
CEDP_GOOGLE_CUSTOMER_ID=my_customer

# ---------------------------------------------------------------------------
# Defaults for the new sending domain (all overridable per run)
# ---------------------------------------------------------------------------
CEDP_MAILBOX_LOCAL_PART=connect
CEDP_MAILBOX_GIVEN_NAME=
CEDP_MAILBOX_FAMILY_NAME=

CEDP_MX_MODE=single
CEDP_SPF_VALUE=v=spf1 include:_spf.google.com ~all
CEDP_DKIM_SELECTOR=google
CEDP_DMARC_POLICY=none
CEDP_DMARC_RUA=
CEDP_DMARC_PCT=100

# Public resolvers used to verify records independently of Cloudflare's own API.
CEDP_RESOLVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------------------
# Registrant contact (Cloudflare registration)
# ---------------------------------------------------------------------------
# Optional: if a default registrant contact is configured on the Cloudflare
# account, leave these blank and the tool omits the contacts block.
CEDP_REGISTRANT_FIRST_NAME=
CEDP_REGISTRANT_LAST_NAME=
CEDP_REGISTRANT_ORGANIZATION=
CEDP_REGISTRANT_EMAIL=
CEDP_REGISTRANT_PHONE=
CEDP_REGISTRANT_ADDRESS=
CEDP_REGISTRANT_CITY=
CEDP_REGISTRANT_STATE=
CEDP_REGISTRANT_POSTAL_CODE=
CEDP_REGISTRANT_COUNTRY=
